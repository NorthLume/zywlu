---
import BrandMark from '../components/BrandMark.astro';
import { site } from '../config/site';
import { firstGuides, topics, writingPrinciples } from '../data/home';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const year = new Date().getFullYear();
---

<BaseLayout>
  <a class="skip-link" href="#main-content">跳到主要内容</a>

  <header class="site-header">
    <div class="site-header__inner page-shell">
      <a class="brand" href="/" aria-label="ZYWLU 首页">
        <BrandMark size={34} />
        <span class="brand__name">ZYWLU</span>
        <span class="brand__descriptor">公益开源技术分享</span>
      </a>

      <nav class="site-nav" aria-label="主要导航">
        <ul>
          <li><a href="#topics">技术专题</a></li>
          <li><a href="#guides">首批内容</a></li>
          <li><a href="#projects">开源项目</a></li>
          <li><a href="#principles">写作原则</a></li>
        </ul>
      </nav>

      <a class="header-github" href={site.repository} target="_blank" rel="noreferrer">
        <span>GitHub</span>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16">
          <path d="M3 13 13 3M5 3h8v8" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero" aria-labelledby="page-title">
      <div class="hero__grid page-shell">
        <div class="hero__content">
          <p class="section-kicker">
            <span class="section-kicker__index">00</span>
            OPEN SOURCE · PUBLIC KNOWLEDGE
          </p>
          <h1 id="page-title">把复杂技术，<span>讲到真正能跑起来。</span></h1>
          <p class="hero__lede">
            ZYWLU
            是一个公益开源技术分享计划。我们把真实执行过的过程、踩过的坑和可回退的方案，整理成任何人都能免费使用的中文技术内容。
          </p>

          <div class="hero__actions">
            <a class="button button--primary" href="#guides">
              查看首批内容
              <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
                <path
                  d="m5 10 10 0m-4-4 4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"></path>
              </svg>
            </a>
            <a class="button button--quiet" href={site.repository} target="_blank" rel="noreferrer">
              参与开源
            </a>
          </div>

          <p class="hero__promise">
            <span aria-hidden="true"></span> 免费开放 · 真实验证 · 社区纠错
          </p>
        </div>

        <aside class="terminal" aria-label="ZYWLU 内容质量标准">
          <div class="terminal__bar">
            <span>zywlu / quality-check</span>
            <span class="terminal__status"><i aria-hidden="true"></i> LIVE</span>
          </div>
          <div class="terminal__body">
            <p><span class="terminal__prompt">$</span> zywlu verify --article latest</p>
            <ol>
              <li><span>01</span><strong>环境写清楚</strong><em>PASS</em></li>
              <li><span>02</span><strong>命令能复现</strong><em>PASS</em></li>
              <li><span>03</span><strong>错误有解释</strong><em>PASS</em></li>
              <li><span>04</span><strong>步骤可回退</strong><em>PASS</em></li>
            </ol>
            <p class="terminal__result">✓ ready for everyone</p>
          </div>
          <div class="terminal__footer">
            <span>NO PAYWALL</span>
            <span>OPEN FOR REVIEW</span>
          </div>
        </aside>
      </div>

      <ul class="hero__facts page-shell" aria-label="项目特征">
        <li><strong>100%</strong><span>开放阅读</span></li>
        <li><strong>0</strong><span>广告与追踪器</span></li>
        <li><strong>AA</strong><span>无障碍目标</span></li>
        <li><strong>PR</strong><span>共同校验内容</span></li>
      </ul>
    </section>

    <div class="topic-ribbon" aria-hidden="true">
      <div class="page-shell">
        <span>WEB DEVELOPMENT</span><i></i>
        <span>LINUX & SERVERS</span><i></i>
        <span>OPEN SOURCE</span><i></i>
        <span>ACCESSIBILITY</span><i></i>
        <span>DEBUGGING</span>
      </div>
    </div>

    <section class="section topics" id="topics" aria-labelledby="topics-title">
      <div class="page-shell">
        <div class="section-heading">
          <p class="section-kicker">
            <span class="section-kicker__index">01</span>
            WHAT WE SHARE
          </p>
          <div>
            <h2 id="topics-title">从能用，<br />到真正理解。</h2>
            <p>围绕真实项目建立知识脉络，让每篇文章既能解决眼前问题，也能解释背后的原因。</p>
          </div>
        </div>

        <div class="topic-grid">
          {
            topics.map((topic) => (
              <article class="topic-card">
                <div class="topic-card__top">
                  <span>{topic.index}</span>
                  <small>{topic.label}</small>
                </div>
                <h3>{topic.title}</h3>
                <p>{topic.description}</p>
                <ul aria-label={`${topic.title}标签`}>
                  {topic.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section guides" id="guides" aria-labelledby="guides-title">
      <div class="page-shell">
        <div class="section-heading section-heading--compact">
          <p class="section-kicker">
            <span class="section-kicker__index">02</span>
            FIRST GUIDES
          </p>
          <div>
            <h2 id="guides-title">第一批内容，<br />从我们亲手做过的事开始。</h2>
            <p>先把建站、服务器和开源仓库的完整过程写透，再逐步扩展专题。</p>
          </div>
        </div>

        <div class="guide-grid">
          {
            firstGuides.map((guide, index) => (
              <article class:list={['guide-card', { 'guide-card--featured': index === 0 }]}>
                <div class="guide-card__meta">
                  <span>{guide.number}</span>
                  <strong>{guide.status}</strong>
                </div>
                <div class="guide-card__content">
                  <p>{guide.category}</p>
                  <h3>{guide.title}</h3>
                  <div class="guide-card__description">{guide.description}</div>
                </div>
                <footer>
                  <span>{guide.meta}</span>
                  <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
                    <path
                      d="m5 12 14 0m-5-5 5 5-5 5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>
                </footer>
              </article>
            ))
          }
        </div>

        <div class="guides-note">
          <span>内容进度公开</span>
          <p>选题、草稿、示例代码和修订记录都会留在 GitHub。文章发布前先保证步骤真实可复现。</p>
          <a href={site.repository} target="_blank" rel="noreferrer">查看仓库进度 →</a>
        </div>
      </div>
    </section>

    <section class="section projects" id="projects" aria-labelledby="projects-title">
      <div class="page-shell projects__grid">
        <div class="projects__intro">
          <p class="section-kicker section-kicker--dark">
            <span class="section-kicker__index">03</span>
            BUILD IN PUBLIC
          </p>
          <h2 id="projects-title">不只分享答案，<br />也把工具真正做出来。</h2>
          <p>
            技术分享负责讲清楚，公益开源项目负责验证它。所有项目从需求、设计到发布过程都公开，文章与源码互相印证。
          </p>
          <a class="button button--light" href={site.repository} target="_blank" rel="noreferrer">
            浏览 GitHub 仓库
            <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
              <path d="m5 10 10 0m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"
              ></path>
            </svg>
          </a>
        </div>

        <article class="open-project">
          <header>
            <div>
              <span>OPEN PROJECT / 001</span>
              <strong>规划中</strong>
            </div>
            <h3>公益主页模板</h3>
            <p>让小型公益组织和社区志愿项目，也能低成本拥有快速、无障碍、可信的网站。</p>
          </header>

          <div class="project-tree" aria-label="公益主页模板计划结构">
            <p><span>zywlu-kindpage/</span></p>
            <p><i>├─</i> content/ <em>简单填写内容</em></p>
            <p><i>├─</i> themes/ <em>无障碍主题</em></p>
            <p><i>├─</i> deploy/ <em>一键静态发布</em></p>
            <p><i>└─</i> docs/ <em>中文使用说明</em></p>
          </div>

          <footer>
            <span>ASTRO</span>
            <span>WCAG 2.2 AA</span>
            <span>STATIC FIRST</span>
          </footer>
        </article>
      </div>
    </section>

    <section class="section principles" id="principles" aria-labelledby="principles-title">
      <div class="page-shell">
        <div class="section-heading">
          <p class="section-kicker">
            <span class="section-kicker__index">04</span>
            HOW WE WRITE
          </p>
          <div>
            <h2 id="principles-title">可信内容，<br />需要一套笨办法。</h2>
            <p>少一点“应该可以”，多一点已经运行过的命令、输出和边界。</p>
          </div>
        </div>

        <ol class="principle-grid">
          {
            writingPrinciples.map((principle) => (
              <li>
                <span>{principle.index}</span>
                <h3>{principle.title}</h3>
                <p>{principle.description}</p>
              </li>
            ))
          }
        </ol>

        <blockquote>
          <p>“开源不只是把代码放出来，也包括把为什么这样做、哪里会失败，诚实地留下来。”</p>
          <footer>— ZYWLU 内容原则</footer>
        </blockquote>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="page-shell closing__inner">
        <div>
          <p class="section-kicker section-kicker--dark">
            <span class="section-kicker__index">05</span>
            OPEN FOR CONTRIBUTION
          </p>
          <h2 id="closing-title">这不是一个人的博客。</h2>
        </div>
        <div class="closing__content">
          <p>
            发现命令过期、步骤遗漏，或者你有一段值得公开的实战经验，都欢迎从一个
            Issue、一次纠错开始。
          </p>
          <a class="button button--dark" href={site.repository} target="_blank" rel="noreferrer">
            前往 GitHub 参与
            <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18">
              <path d="m5 10 10 0m-4-4 4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-shell site-footer__inner">
      <a class="brand brand--footer" href="/" aria-label="ZYWLU 首页">
        <BrandMark size={30} />
        <span class="brand__name">ZYWLU</span>
      </a>
      <p>把复杂技术讲清楚，把可复现方案免费留下来。</p>
      <div>
        <a href={site.githubProfile} target="_blank" rel="noreferrer">GitHub</a>
        <span>© {year} ZYWLU</span>
      </div>
    </div>
  </footer>
</BaseLayout>
